# ─────────────────────────────────────────────────────────────
# .env.production.example
# Copie en `.env` sur le serveur de prod, remplace les <…>, NE PAS COMMIT.
# ─────────────────────────────────────────────────────────────

# ─── Réseau & exposition ─────────────────────────────────────
# Tous les ports n'écoutent que sur la loopback : nginx reverse-proxy depuis 127.0.0.1
BIND_IP=127.0.0.1
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=3000
DB_HOST_PORT=5433

# ─── Backend ─────────────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=<openssl rand -hex 64>
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://coaching.tondomaine.fr

# ─── Base de données ────────────────────────────────────────
POSTGRES_USER=coaching
POSTGRES_PASSWORD=<long_random_password>
POSTGRES_DB=coaching_db

# ─── Mots de passe seed (lus uniquement au premier démarrage avec DB vide) ────
SEED_ADMIN_PASSWORD=<long>
SEED_COACH_PASSWORD=<long>
SEED_EMPLOYEE_PASSWORD=<long>
SEED_DEMO_PASSWORD=<long>
