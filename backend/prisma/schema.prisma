generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COACH
  EMPLOYEE
}

enum SessionType {
  SOLO
  DUO
}

enum ReservationStatus {
  CONFIRMED
  WAITING
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CANCELLED
}

enum NotificationType {
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  SESSION_REMINDER
  DUO_PARTNER_JOINED
  DUO_PARTNER_LEFT
  STRIKE_ADDED
  ACCOUNT_UNBLOCKED
}

enum GoalType {
  WEIGHT_LOSS
  CARDIO
  MUSCLE_GAIN
  FLEXIBILITY
  OTHER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  firstName    String
  lastName     String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  strikes      Int       @default(0)
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reservations     Reservation[]
  coachSessions    Session[]     @relation("CoachSessions")
  employeeGoals    Goal[]        @relation("EmployeeGoals")
  coachGoals       Goal[]        @relation("CoachGoals")
  employeePrograms Program[]     @relation("EmployeePrograms")
  coachPrograms    Program[]     @relation("CoachPrograms")
  progressLogs     ProgressLog[]
  notifications    Notification[]
}


model Session {
  id        String      @id @default(cuid())
  date      DateTime
  duration  Int
  type      SessionType
  capacity  Int
  isLocked  Boolean     @default(false)
  coachId   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  coach        User          @relation("CoachSessions", fields: [coachId], references: [id])
  reservations Reservation[]
}

model Reservation {
  id         String            @id @default(cuid())
  status     ReservationStatus @default(CONFIRMED)
  attendance AttendanceStatus?
  userId     String
  sessionId  String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  userId    String
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  id          String     @id @default(cuid())
  type        GoalType
  title       String
  description String?
  targetDate  DateTime?
  status      GoalStatus @default(ACTIVE)
  employeeId  String
  coachId     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employee    User          @relation("EmployeeGoals", fields: [employeeId], references: [id])
  coach       User          @relation("CoachGoals", fields: [coachId], references: [id])
  program     Program?
  progressLogs ProgressLog[]
}

model Program {
  id         String   @id @default(cuid())
  title      String
  content    String
  goalId     String?  @unique
  employeeId String
  coachId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  goal     Goal? @relation(fields: [goalId], references: [id])
  employee User  @relation("EmployeePrograms", fields: [employeeId], references: [id])
  coach    User  @relation("CoachPrograms", fields: [coachId], references: [id])
}

model ProgressLog {
  id         String   @id @default(cuid())
  goalId     String
  note       String
  value      Float?
  loggedById String
  createdAt  DateTime @default(now())

  goal     Goal @relation(fields: [goalId], references: [id])
  loggedBy User @relation(fields: [loggedById], references: [id])
}
